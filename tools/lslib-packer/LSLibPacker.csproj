<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LSLibDir Condition="'$(LSLibDir)' == ''">$(LSLIB_DIR)</LSLibDir>
  </PropertyGroup>
  <Target Name="ValidateLSLib" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(LSLibDir)/LSLib.dll')" Text="Set LSLIB_DIR to the LSLib Packed/Tools directory." />
  </Target>
  <ItemGroup>
    <Reference Include="LSLib">
      <HintPath>$(LSLibDir)/LSLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(LSLibDir)/*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
